node_modules/
# Generated by `envio codegen` from config.yaml and schema.graphql.
generated/
# Local indexer state: a Postgres volume and the run's own logs.
.envio/
logs/

# Generated per-run by scripts/index-local.sh from config.yaml: it
# carries the local chain address and a skip flag, neither of which
# belongs in the deployed config.
config.local.yaml

# Secrets. ENVIO_API_TOKEN authenticates HyperSync; it is a credential,
# never a build input, and must not reach a commit.
.env
.env.*
!.env.example
