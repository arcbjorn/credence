# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# HyperSync authenticates with an API token, free from
# https://envio.dev/app/api-tokens. Without one `scripts/index-local.sh`
# skips chain 10143 and indexes the local chain over RPC, which is enough
# for the demo and not enough for the deployed-chain claim in `docs/08`.
ENVIO_API_TOKEN=
